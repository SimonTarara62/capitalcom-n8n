{
  "name": "n8n-nodes-capitalcom",
  "version": "0.3.0-rc.4",
  "description": "Unofficial n8n community node for the Capital.com Open API — market data, accounts, watchlists, trading, and WebSocket streaming.",
  "keywords": [
    "n8n-community-node-package",
    "capital.com",
    "trading",
    "cfd",
    "market-data",
    "finance"
  ],
  "license": "MIT",
  "homepage": "https://github.com/SimonTarara62/capitalcom-n8n",
  "author": {
    "name": "Simon Tarara",
    "email": "33222802+SimonTarara62@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonTarara62/capitalcom-n8n.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "publishConfig": {
    "_comment": "REMOVE or set to \"latest\" before publishing the stable 0.3.0. npm refuses to publish a prerelease without an explicit dist-tag, and n8n-node release runs a bare `npm publish`.",
    "tag": "rc"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/CapitalComApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CapitalCom/CapitalCom.node.js",
      "dist/nodes/CapitalComTrigger/CapitalComTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.48.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.21",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.3"
  }
}
